# Local Development Environment Variables
# Copy this to .env and update values

# Database - SQLite for local dev, PostgreSQL for production
DATABASE_URL=sqlite:///./test.db

# JWT Secret - CHANGE THIS IN PRODUCTION (must be 32+ characters)
SECRET_KEY=dev-secret-key-change-in-production-must-be-long

# S3 Configuration (optional for local testing without S3)
S3_BUCKET_NAME=your-test-bucket
AWS_REGION=ap-south-1

# For local S3 testing, you can use LocalStack or MinIO
# S3_ENDPOINT_URL=http://localhost:4566

# CORS - Frontend URLs allowed to access the API
CORS_ORIGINS=http://localhost:8000,http://localhost:3000,http://127.0.0.1:8000
